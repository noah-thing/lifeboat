{
  "name": "lifeboat-cli",
  "version": "0.2.0",
  "description": "Fail over to another coding agent, then to a local model, when your agent is rate limited, banned or down.",
  "type": "module",
  "bin": {
    "lifeboat": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "dev": "tsx src/cli.ts",
    "lifeboat": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "coding-agent",
    "failover",
    "rate-limit",
    "claude-code",
    "codex",
    "aider",
    "opencode",
    "ollama",
    "cli",
    "gemini-cli",
    "grok"
  ],
  "author": "Noah",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noah-thing/lifeboat.git"
  },
  "homepage": "https://github.com/noah-thing/lifeboat#readme",
  "bugs": {
    "url": "https://github.com/noah-thing/lifeboat/issues"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "execa": "^10.2.1",
    "picocolors": "^1.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.6.0"
}
